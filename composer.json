{
    "name": "kaiphpdev/laravel-correlation-id",
    "description": "End-to-end correlation ID tracing for Laravel HTTP requests, logs, outgoing HTTP calls, and queued jobs.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "correlation-id",
        "request-id",
        "tracing",
        "logging",
        "queue",
        "http-client"
    ],
    "authors": [
        {
            "name": "Kai"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelCorrelationId\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelCorrelationId\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelCorrelationId\\CorrelationIdServiceProvider"
            ],
            "aliases": {
                "CorrelationId": "LaravelCorrelationId\\Facades\\CorrelationId"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "format-check": "pint --test",
        "validate": "composer validate --strict",
        "check": [
            "@validate",
            "@format-check",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}